{
  "name": "2soon2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/artifact.mjs",
    "typecheck": "tsc --noEmit",
    "sim": "node --experimental-strip-types scripts/headless.ts",
    "check": "node scripts/check-all.ts",
    "check:geo": "node scripts/geo-check.ts",
    "check:paths": "node scripts/paths-check.ts",
    "eleven:agent": "node scripts/eleven-agent.ts",
    "check:econ": "node scripts/econ-check.ts",
    "check:orbits": "node scripts/orbit-check.ts",
    "check:impacts": "node scripts/impact-check.ts",
    "check:camera": "node scripts/camera-check.ts",
    "check:impactviz": "esbuild scripts/impact-viz-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/impact-viz-check.mjs --log-level=warning && node node_modules/.cache/impact-viz-check.mjs",
    "ingest": "node scripts/ingest.ts",
    "calibrate:msis": "node scripts/msis-calibrate.ts",
    "check:people": "node scripts/people-check.ts",
    "check:perf": "node scripts/people-check.ts --perf",
    "check:life": "node scripts/lifepick-check.ts",
    "check:data": "node scripts/query-check.ts && node scripts/data-check.ts",
    "check:trends": "node scripts/trends-check.ts",
    "check:golden": "node scripts/war-golden.ts",
    "check:war": "node scripts/war-mind-check.ts",
    "check:explain": "esbuild scripts/explain-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/explain-check.mjs --log-level=warning && node node_modules/.cache/explain-check.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "satellite.js": "^7.1.0",
    "three": "^0.186.1"
  }
}
